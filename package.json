{
  "name": "steadykey",
  "version": "3.0.0",
  "description": "Deterministic idempotency key manager for JSON payloads with multi-backend storage, an execute-once runner, and HTTP middleware. Zero dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/middleware.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "tsc --noEmit && eslint .",
    "prepare": "npm run build"
  },
  "keywords": [
    "idempotency",
    "redis",
    "typescript",
    "deterministic",
    "memcached",
    "postgresql",
    "mysql",
    "mongodb",
    "sqlite",
    "dynamodb",
    "exactly-once",
    "deduplication",
    "idempotency-key",
    "middleware"
  ],
  "author": "steadykey contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "eslint": "^10.8.0",
    "fastify": "^5.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ebogdum/steadykey.git"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.9"
  }
}
